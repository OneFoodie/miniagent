# 环境变量（含密钥，禁止入库）
.env

# MCP 服务配置（含本机路径与凭据，每人一份；模板见 mcp.example.json）
mcp.json

# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# 测试与运行产物
coverage/
workspace/
traces/
eval_reports/
history/
memory/
# 运行存档：只留中断/挂起的运行，属于本机产物
checkpoints/

# 向量知识库：索引文件 + 模型缓存 + 模型本体（体积大，用 npm run model:fetch 重建）
vector-db/
.cache/
models/

# Python 残留（项目最初按 Python 规划，已改为 TypeScript）
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 编辑器与系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
