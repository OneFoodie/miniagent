# API Key（云端服务商必填）。DeepSeek 申请地址: https://platform.deepseek.com/
#   通用变量是 MINIAGENT_API_KEY；下面这个 DeepSeek 专用名继续兼容（二者取其一即可）
MINIAGENT_DEEPSEEK_API_KEY=sk-your-key-here

# 模型服务商：deepseek | openai | moonshot | dashscope | zhipu | ollama | custom
#   预设只提供「接入点 + 默认模型名」，客户端本身只依赖 OpenAI 兼容协议
#   未列出的服务商用 custom + MINIAGENT_BASE_URL + MINIAGENT_MODEL 接入
# MINIAGENT_PROVIDER=deepseek
# API Key：云端服务商必填；localhost 端点（ollama 等）不校验、可不填
# MINIAGENT_API_KEY=sk-your-key-here
# 接入点与模型名：不填则取 provider 预设；填了即覆盖（自建网关走这里）
# MINIAGENT_BASE_URL=https://api.deepseek.com
# MINIAGENT_MODEL=deepseek-chat
# MINIAGENT_MAX_ITERATIONS=8
# MINIAGENT_TOOL_TIMEOUT=30
# MINIAGENT_MAX_CONCURRENCY=8
# 流式（token 级）：默认开启以便逐字显示；服务端不支持时会自动去掉 stream_options 重试一次
# MINIAGENT_STREAM_ENABLED=true
# 单个工具结果回灌上下文时的字符上限（0 表示不限制）
#   超限时会把完整内容卸载到 ./workspace/offload/<runId>/，上下文里只留预览 + 路径，可用 read_file 取回
# MINIAGENT_TOOL_RESULT_MAX_CHARS=4000
# 保留多少个 run 的卸载产物，更早的删除（0 表示不清理）
# MINIAGENT_OFFLOAD_KEEP_RUNS=50
# 子 agent：自己一轮最多跑多少步、单次执行超时（秒）
#   run_subagent 可指定角色 researcher / analyst / critic（角色同时决定提示词与工具白名单）
#   run_subagents 并行派发 2-5 个互不依赖的子任务
# MINIAGENT_SUBAGENT_MAX_ITERATIONS=6
# MINIAGENT_SUBAGENT_TIMEOUT=180
# MINIAGENT_WORKSPACE=./workspace
# MINIAGENT_TRACE_DIR=./traces

# 通用执行通道（powershell 工具）：把本机 shell 交给模型
#   注意：这个工具**没有沙箱**——子进程权限 = 本进程权限，能读写 workspace 之外的路径
#   档位：off 不注册 | readonly 只放行只读 cmdlet、且必须是单条简单命令（默认）| full 不限制
#   readonly 保证的是「不写」，不保证「不读出沙箱外的东西」（Get-ChildItem C:\ 仍然可读）
#   切到 full 时建议同时把 powershell 加进 MINIAGENT_APPROVAL_TOOLS，让每次执行都过人工审批
# MINIAGENT_POWERSHELL_MODE=readonly
# 单条命令的超时（秒）：作为默认值；单次执行可用工具的 timeout_seconds 参数调大，
#   full 档上限取「本值」与 300 的较大者，readonly 档不接受调大
# MINIAGENT_POWERSHELL_TIMEOUT=30
# 可执行文件：留空则 Windows 用 powershell、其它平台用 pwsh（PowerShell 7）
# MINIAGENT_POWERSHELL_EXECUTABLE=

# 运行存档（断点续跑 + 人工审批）：每轮迭代后落盘，成功即删，只留中断/挂起的
#   关掉它就没有续跑与审批这两项能力
# MINIAGENT_CHECKPOINT_DIR=./checkpoints
# MINIAGENT_CHECKPOINT_ENABLED=true
# 需要人工审批的工具名（逗号分隔，如 write_file）：命中即挂起，等人批准后再继续
# MINIAGENT_APPROVAL_TOOLS=

# MCP 工具来源：配了 mcp.json（可参考 mcp.example.json）才会加载 MCP SDK 并连接远端
#   不配则完全不加载 SDK（它依赖 79 个包），默认路径依赖数量不变
# MINIAGENT_MCP_CONFIG=./mcp.json

# OpenTelemetry 导出（OTLP/HTTP JSON）：默认关闭，只写本地 JSONL 轨迹
#   打开后按 GenAI 语义约定发 span 到 /v1/traces、指标到 /v1/metrics
# MINIAGENT_OTEL_ENABLED=false
# 端点与服务名也可用官方变量 OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_SERVICE_NAME 注入
# MINIAGENT_OTEL_ENDPOINT=http://localhost:4318
# MINIAGENT_OTEL_SERVICE_NAME=miniagent
# 附加请求头（如鉴权），形如 key1=value1,key2=value2
# MINIAGENT_OTEL_HEADERS=
# 单次导出超时（秒）
# MINIAGENT_OTEL_TIMEOUT=10
# 指标上报间隔（秒）；0 表示只在进程退出时上报一次
# MINIAGENT_OTEL_METRICS_INTERVAL=60

# 阶段二：技能 / 记忆 / 会话历史
#   技能目录：模型可以用 create_skill 往里写新技能（写完立即生效），所以这个目录是「模型可写」的
# MINIAGENT_SKILLS_DIR=./skills
# MINIAGENT_HISTORY_DIR=./history
# MINIAGENT_MEMORY_FILE=./memory/long_term.jsonl
# 历史消息预算 = 模型窗口 × 比例；换模型只改窗口，预算自动跟着变
# MINIAGENT_MODEL_CONTEXT_TOKENS=131072
# MINIAGENT_MEMORY_BUDGET_RATIO=0.25
# 想写死预算就配这一项（>0 时优先于上面两项的推导）
# MINIAGENT_MEMORY_MAX_TOKENS=0
# 被裁掉的历史达到该 token 数才触发摘要压缩（刻意不随窗口伸缩，衡量的是「值不值得花一次 LLM 调用」）
# MINIAGENT_MEMORY_SUMMARY_THRESHOLD=2000

# 长期记忆后端: jsonl | lifecycle | memos
#   留空则自动选择——配了下面的 MemOS key 用 memos，否则用 jsonl
#   lifecycle = 本地生命周期记忆（置信度 / 矛盾消解 / Ebbinghaus 遗忘曲线 / 四信号排序）
# MINIAGENT_MEMORY_BACKEND=lifecycle
# MINIAGENT_LIFECYCLE_MEMORY_FILE=./memory/lifecycle.jsonl

# 记忆巩固：可检索条数超过阈值时，把最低分的一批用 LLM 压成一条归档摘要
#   原记录不删除，只标记 consolidatedInto 并移出检索集
# MINIAGENT_MEMORY_CONSOLIDATE_THRESHOLD=400
# MINIAGENT_MEMORY_CONSOLIDATE_BATCH=40
# MINIAGENT_MEMORY_ARCHIVE_CHARS=400

# 知识库：扫描目录下的纯文本文件（.md/.txt/.json/.csv/代码等），由 search_knowledge 工具按需检索
#   可配多个目录（逗号分隔）；改完文档无需重启进程（按 mtime 自动重建索引）
#   二进制格式（PDF/Word/Excel）先用 `npm run knowledge:add <文件>` 转成 Markdown
# MINIAGENT_KNOWLEDGE_DIR=./knowledge
# MINIAGENT_KNOWLEDGE_CHUNK_CHARS=600
# MINIAGENT_KNOWLEDGE_CHUNK_OVERLAP=80

# 检索引擎: lexical | vector | hybrid
#   lexical = 内存 TF-IDF 词面检索（零依赖，跨语言与同义改写会零召回）
#   vector  = LanceDB 向量检索（语义召回，需要 embedding 模型；见下方 EMBEDDING_* 配置）
#   hybrid  = 词面 + 语义两路召回，RRF 融合（精确 token 与同义改写都不漏）
#             任一路失败会自动降级为另一路
#   后两者要 @lancedb/lancedb 与 @huggingface/transformers（optionalDependencies）：
#     轻量环境可以 `npm ci --omit=dev --omit=optional` 完全不装它们，只用 lexical；
#     此时若仍把后端配成 vector/hybrid，运行期会给出「装依赖」或「换回 lexical」的提示。
# MINIAGENT_KNOWLEDGE_BACKEND=lexical

# 混合检索专用（MINIAGENT_KNOWLEDGE_BACKEND=hybrid 时生效）
#   两路权重：更倚重精确匹配（代号/编号）就调大 lex，更倚重同义召回就调大 vec
# MINIAGENT_HYBRID_LEXICAL_WEIGHT=1
# MINIAGENT_HYBRID_VECTOR_WEIGHT=1
# RRF 常数 k：越大则头部排名之间的差距越被压平（默认 60，原论文经验值）
# MINIAGENT_HYBRID_RRF_K=60

# 语义后端专用（MINIAGENT_KNOWLEDGE_BACKEND=vector 或 hybrid 时生效）
#   向量索引落盘目录；删掉即全量重建，建议加入 .gitignore
# MINIAGENT_VECTOR_DB_PATH=./vector-db
# 嵌入模型（transformers.js 的 ONNX 模型 ID，多语言）
# MINIAGENT_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# 模型权重精度: fp32 | fp16 | q8 | int8 | q4 | q4f16（越小越快越省内存，召回略降）
# MINIAGENT_EMBEDDING_DTYPE=q8
# 本地模型目录：放 <模型ID>/onnx/model_<精度>.onnx + config.json + tokenizer 等；
#   目录与文件齐备时完全离线加载，不走网络。用 `npm run model:fetch` 下载
# MINIAGENT_EMBEDDING_LOCAL_MODEL_PATH=./models
# 没配本地模型时的下载源（国内直连 huggingface.co 会超时，用镜像）
# MINIAGENT_EMBEDDING_REMOTE_HOST=https://hf-mirror.com
# 模型缓存目录（远程下载时的落点）
# MINIAGENT_EMBEDDING_CACHE_DIR=./.cache/embeddings

# MemOS 云记忆（可选）：填了 API Key 就走 MemOS，留空则用上面的本地实现
# 申请地址: https://memos-dashboard.openmem.net/apikeys/
# MINIAGENT_MEMOS_API_KEY=mpg-xxxxxxxxxxxxxxxx
# MINIAGENT_MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
# MINIAGENT_MEMOS_USER_ID=miniagent-local
# MINIAGENT_MEMOS_TIMEOUT=15
